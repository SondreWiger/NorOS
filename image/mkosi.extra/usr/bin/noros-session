#!/bin/sh
# Starts the NorOS desktop for the logged-in user.

export XDG_CURRENT_DESKTOP=NorOS
export XDG_SESSION_DESKTOP=NorOS
export XCURSOR_THEME=Adwaita
export XCURSOR_SIZE=24
export MOZ_ENABLE_WAYLAND=1
export QT_QPA_PLATFORM="wayland;xcb"
export SDL_VIDEODRIVER=wayland
# The per-user message bus (apps, sound and the browser's sandbox need it).
if [ -S "$XDG_RUNTIME_DIR/bus" ]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
fi
# Apps installed with Flatpak show up in search and the dock.
export XDG_DATA_DIRS="$HOME/.local/share/flatpak/exports/share:/var/lib/flatpak/exports/share:/usr/local/share:/usr/share"

# Virtual machines usually have no 3D acceleration: render on the CPU.
# Set NOROS_HW_ACCEL=1 to skip this (e.g. a VM with virgl).
if [ -z "$NOROS_HW_ACCEL" ] && systemd-detect-virt --vm --quiet; then
    export LIBGL_ALWAYS_SOFTWARE=1
    export GSK_RENDERER=cairo
    export WEBKIT_DISABLE_DMABUF_RENDERER=1
fi

exec fjord

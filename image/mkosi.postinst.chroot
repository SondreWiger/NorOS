#!/bin/sh
# Runs inside the image after all packages are installed.
set -e

# The default user. 0.1 is a development build: password "noros".
if ! id noros >/dev/null 2>&1; then
    useradd --create-home --shell /bin/bash --comment "NorOS" noros
fi
echo 'noros:noros' | chpasswd
for group in sudo video render input; do
    if getent group "$group" >/dev/null; then
        usermod -aG "$group" noros
    fi
done

systemctl enable noros-session.service
systemctl enable systemd-networkd.service systemd-resolved.service
systemctl set-default graphical.target

# Development builds mirror the system log to the serial port, so automated
# boot tests can follow along. Remove before release.
case "$(dpkg --print-architecture)" in
    arm64) serial=ttyAMA0 ;;
    *)     serial=ttyS0 ;;
esac
mkdir -p /etc/systemd/journald.conf.d
printf '[Journal]\nForwardToConsole=yes\nTTYPath=/dev/%s\nMaxLevelConsole=info\n' "$serial" \
    > /etc/systemd/journald.conf.d/10-serial.conf
